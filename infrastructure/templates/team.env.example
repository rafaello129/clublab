# ClubLab team runtime environment template
# Copy to: /home/tulum/infra/clublab/runtime/teams/teamXX.env
# Runtime file permissions: 0600
# Never commit generated values.

CLUBLAB_GENERATION_ID=REPLACE_ME
CLUBLAB_TEAM_ID=team01
