# ClubLab gateway runtime environment template
# Copy to: /home/tulum/infra/clublab/runtime/gateway.env
# Runtime file permissions: 0600

CLUBLAB_BIND_IP=10.10.100.41
CLUBLAB_GATEWAY_IMAGE=REPLACE_WITH_PINNED_IMAGE

# Terminal authentication values belong here only when the final
# gateway configuration consumes them as hashes.
TEAM01_TERMINAL_USER=team01
TEAM01_TERMINAL_PASSWORD_HASH=REPLACE_ME
TEAM02_TERMINAL_USER=team02
TEAM02_TERMINAL_PASSWORD_HASH=REPLACE_ME
TEAM03_TERMINAL_USER=team03
TEAM03_TERMINAL_PASSWORD_HASH=REPLACE_ME
TEAM04_TERMINAL_USER=team04
TEAM04_TERMINAL_PASSWORD_HASH=REPLACE_ME
TEAM05_TERMINAL_USER=team05
TEAM05_TERMINAL_PASSWORD_HASH=REPLACE_ME
TEAM06_TERMINAL_USER=team06
TEAM06_TERMINAL_PASSWORD_HASH=REPLACE_ME
SPARE_TERMINAL_USER=spare
SPARE_TERMINAL_PASSWORD_HASH=REPLACE_ME
